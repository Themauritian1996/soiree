rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur ne voit que son propre pointeur de foyer
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /households/{hid} {
      allow get: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.resource.data.members == [request.auth.uid];
      // Membre : peut tout modifier. Non-membre avec le code : peut seulement s'ajouter lui-même.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid]))
      );
      allow delete: if false;
      match /items/{itemId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
      }
    }
  }
}
