{
  "appId": "ca.chris.soiree",
  "appName": "Soir\u00e9e",
  "webDir": "dist",
  "backgroundColor": "#0B0B10",
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0B10",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "none",
      "resizeOnFullScreen": false
    }
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "force",
    "allowMixedContent": false
  }
}